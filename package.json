{
  "name": "vortex-optimizer",
  "version": "1.0.1",
  "private": true,
  "description": "Vortex-Optimizer — Fluent-inspired Windows 11 optimization app (Tauri + React)",
  "type": "commonjs",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "vite build",
    "prepackage:win": "npm run version:sync",
    "package:win": "node scripts/check-tools.mjs && tauri build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rename-installer.ps1",
    "version:sync": "node scripts/sync-version.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@paypal/react-paypal-js": "^10.3.0",
    "@supabase/server": "^1.4.1",
    "@supabase/supabase-js": "^2.112.0",
    "@tauri-apps/api": "^2.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vercel/node": "^5.9.5",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.0"
  }
}
